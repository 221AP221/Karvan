# PostgreSQL. Boş qalsa, `npm run dev` lokal bazanı (prisma dev) avtomatik işə salır.
# DATABASE_URL="postgresql://user:pass@host:5432/karvan"

# Tətbiqin ictimai ünvanı (faktura linkləri və QR kod üçün)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI funksiyaları (mətn generasiyası). ƏN ASAN YOL: saytı işə salın, Admin → Parametrlər → AI bölməsində açarı bir dəfə yazın
# (bazada şifrələnir, sayt hər dəfə özü işləyir). Aşağıdakı .env yolu alternativdir; admin ayarı varsa, o üstündür.
# Real serverdə açarları şifrələmək üçün APP_SECRET (uzun təsadüfi mətn) mütləq təyin edin.
APP_SECRET=""
# Yalnız birini seçin. Açar yazmasanız, AI düymələri "AI qoşulmayıb" göstərir.
# Pulsuz variantlar (kart tələb olunmur, limitlər var):
#   groq        — https://console.groq.com          →  AI_PROVIDER=groq        GROQ_API_KEY=...
#   gemini      — https://aistudio.google.com       →  AI_PROVIDER=gemini      GEMINI_API_KEY=...
#   openrouter  — https://openrouter.ai (":free")   →  AI_PROVIDER=openrouter  OPENROUTER_API_KEY=...
#   ollama      — öz kompüterinizdə, tam pulsuz     →  AI_PROVIDER=ollama      (açar lazım deyil; ollama pull llama3.1)
# Ödənişli, ən güclü: ANTHROPIC_API_KEY (Claude).
# Model adı və ünvan dəyişdirilə bilər: AI_MODEL, AI_BASE_URL (pulsuz modellər tez-tez yenilənir, adı yoxlayın).
# AI_PROVIDER boşdursa, doldurulmuş açara görə avtomatik seçilir.
AI_PROVIDER=""
AI_MODEL=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""

# Bildirişlər (M2/M5)
RESEND_API_KEY=""
# Şifrə bərpası məktubları kimin adından gedir, məs. "Karvan <no-reply@karvan.az>"
EMAIL_FROM=""
SMS_PROVIDER_API_KEY=""

# Karvan abunəlik ödənişləri. Kart məlumatı Karvan-a daxil olmur: istifadəçi gateway səhifəsinə yönləndirilir,
# nəticə imzalı webhook ilə gəlir. Test və real rejim EYNİ koddur, yalnız bu açarlar dəyişir.
#
#   Test (pul çıxılmır, test kartları):  PAYMENT_GATEWAY boş buraxın (lokal) və ya PAYMENT_GATEWAY=sandbox
#   Real (canlı), aqreqator seçimi:
#     Epoint:   PAYMENT_GATEWAY=epoint   + EPOINT_PUBLIC_KEY + EPOINT_PRIVATE_KEY
#     Payriff:  PAYMENT_GATEWAY=payriff  + PAYRIFF_SECRET_KEY
#
# Canlıya çıxış siyahısı: 1) NEXT_PUBLIC_APP_URL=https://sizin-domen  2) PAYMENT_GATEWAY=epoint və açarlar
# 3) gateway kabinetində callback/webhook: https://sizin-domen/api/payments/webhook/epoint  (və ya /payriff)  4) BILLING_* rekvizitləri
# Real serverdə PAYMENT_GATEWAY boşdursa kart ödənişi bağlıdır (test rejimi təsadüfən açılmır).
# Webhook ünvanı (gateway kabinetində): $NEXT_PUBLIC_APP_URL/api/payments/webhook/epoint (və ya /payriff)
# Webhook-un işləməsi üçün sayt internetdən əlçatan olmalıdır (lokalda ngrok/cloudflared).
PAYMENT_GATEWAY=
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
# Könüllü: sənəddə ayrıca API/status ünvanı verilibsə, defolt dəyərləri əvəz edir
EPOINT_API_URL=
EPOINT_STATUS_URL=
PAYRIFF_SECRET_KEY=
# Könüllü: Payriff-in API ünvanı dəyişibsə
PAYRIFF_API_URL=
# Test (sandbox) gateway-i imzalayan açar. Production-da PAYMENT_GATEWAY=sandbox seçsəniz, bu MÜTLƏQ
# yazılmalıdır — əks halda sandbox ümumiyyətlə işə düşmür (kodda yazılmış defolt açarla saxta "ödəniş"
# göndərilməsinin qarşısını almaq üçün).
SANDBOX_SECRET=
# Bank köçürməsi üçün Karvan-ın rekvizitləri (boşdursa nümunə göstərilir)
BILLING_RECIPIENT="Karvan MMC"
BILLING_BANK="Kapital Bank ASC"
BILLING_IBAN=
BILLING_VOEN=

# Passiv hesabların avtomatik təmizlənməsi (gündəlik cron) bu açarla qorunur. Təyin edilməyibsə,
# nöqtə bağlıdır — heç kim təsadüfən işə sala bilməz.
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://sizin-domen/api/cron/cleanup
CRON_SECRET=
