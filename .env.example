# PostgreSQL. Boş qalsa, `npm run dev` lokal bazanı (prisma dev) avtomatik işə salır.
# DATABASE_URL="postgresql://user:pass@host:5432/karvan"

# Tətbiqin ictimai ünvanı (faktura linkləri və QR kod üçün)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Anthropic Claude API (AI funksiyaları)
ANTHROPIC_API_KEY=""

# Bildirişlər (M2/M5)
RESEND_API_KEY=""
# Şifrə bərpası məktubları kimin adından gedir, məs. "Karvan <no-reply@karvan.az>"
EMAIL_FROM=""
SMS_PROVIDER_API_KEY=""

# Onlayn ödəniş provayderi (M5)
PAYMENT_GATEWAY_MERCHANT_ID=""
PAYMENT_GATEWAY_SECRET=""

# Karvan abunəlik ödənişləri. Kart məlumatı Karvan-a daxil olmur: istifadəçi gateway səhifəsinə yönləndirilir.
# PAYMENT_GATEWAY boşdursa: lokalda simulyasiya səhifəsi (/pay/sandbox), real serverdə kart ödənişi bağlıdır.
# Epoint üçün: PAYMENT_GATEWAY=epoint + açarlar. Webhook ünvanı (gateway kabinetində): $NEXT_PUBLIC_APP_URL/api/payments/webhook/epoint
# Webhook-un işləməsi üçün sayt internetdən əlçatan olmalıdır (lokalda ngrok/cloudflared).
PAYMENT_GATEWAY=
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
# Bank köçürməsi üçün Karvan-ın rekvizitləri (boşdursa nümunə göstərilir)
BILLING_RECIPIENT="Karvan MMC"
BILLING_BANK="Kapital Bank ASC"
BILLING_IBAN=
BILLING_VOEN=
