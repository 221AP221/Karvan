generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  PRO_MAX
}

enum PriceType {
  FIXED // sabit qiymət: sifariş anında faktura yaranır
  NEGOTIABLE // razılaşma ilə: satıcı təsdiqləyir
}

enum OrderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  CLAIMED_PAID // müştəri "ödədim" dedi, satıcı təsdiqi gözlənilir
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  MANUAL // rekvizit (kart / IBAN)
  ONLINE // payment gateway
  BOTH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum Citizenship {
  AZ // FİN kod
  FOREIGN // pasport nömrəsi
}

enum Channel {
  WHATSAPP
  EMAIL
  SMS
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  WHATSAPP
  TELEGRAM
  YOUTUBE
  FACEBOOK
  LINKEDIN
  BEHANCE
  DRIBBBLE
  X
  THREADS
  PINTEREST
  EMAIL
  WEBSITE
  CUSTOM // ikon yox, düymə kimi göstərilən sərbəst link
}

model User {
  id             String       @id @default(cuid())
  firstName      String?
  lastName       String?
  phone          String?      @unique
  email          String?      @unique
  citizenship    Citizenship?
  finCode        String?      @unique
  passportNumber String?
  passwordHash   String?
  role           Role         @default(USER)
  blockedAt      DateTime? // admin tərəfindən bloklanıb: giriş, səhifə və kataloq bağlıdır
  blockReason    String?
  createdAt      DateTime     @default(now())

  termsAcceptedAt     DateTime? // istifadə şərtlərinin qəbul edildiyi an (qeydiyyatda məcburi)
  termsVersion        String? //   qəbul edilmiş şərtlərin versiyası
  lastSeenAt          DateTime? // son aktivlik: passiv hesabların təmizlənməsi üçün
  autoDeleteAfterDays Int?      @default(90) // null = söndürülüb; passivlik müddəti
  inactiveNoticeAt    DateTime? // silinmədən əvvəl xəbərdarlığın göndərildiyi an

  profile        Profile?
  memberships    Membership[]
  subscription   Subscription?
  sessions       Session[]
  passwordResets PasswordReset[]
  billing        SubscriptionPayment[]
}

model PasswordReset {
  id        String    @id // tokenin sha256 heşi
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id              String   @id // cookie tokeninin sha256 heşi
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeProfileId String? // komanda üzvü hansı iş sahəsində işləyir (boşdursa öz səhifəsi)
  expiresAt       DateTime
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan      @default(FREE)
  currentPeriodEnd DateTime?
}

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String  @unique
  displayName   String
  profession    String? // "Makiyaj ustası", "SMM mütəxəssisi"
  bio           String?
  about         String? // "Haqqımda" bölməsinin uzun mətni
  city          String?
  phone         String? // səhifədə göstərilən əlaqə nömrəsi (zəng et)
  showInCatalog Boolean @default(true) // xidmətlər kataloqunda görünür
  avatarUrl     String? // şəkil və ya loqo
  coverUrl      String?
  invoicePrefix String  @default("INV")
  invoiceSeq    Int     @default(0)
  // Aylıq faktura limiti: silinmiş fakturalar limiti geri qaytarmasın deyə ayrıca sayğac
  invoiceQuotaMonth DateTime?
  invoiceQuotaUsed  Int      @default(0)
  // Tema: { primary, background, text, font, buttonStyle }
  theme         Json?

  // Manual ödəniş rekvizitləri
  cardNumber  String?
  iban        String?
  bankName    String?
  accountName String?

  socialLinks   SocialLink[]
  portfolio     PortfolioItem[]
  media         Media[]
  services      Service[]
  orders        Order[]
  invoices      Invoice[]
  events        ProfileEvent[]
  reviews       Review[]
  notifications Notification[]

  // Reytinq xülasəsi: kataloqda sıralama və satıcı səhifəsi üçün saxlanılır (rəy əlavə olunanda yenilənir)
  ratingAvg   Float? // 1.0 - 5.0
  ratingCount Int    @default(0)

  // Bildiriş ayarları: hansı hadisə hansı kanalla getsin və avtomatikmi
  notifyMode     NotifyMode            @default(AUTO)
  notifyChannels NotificationChannel[] @default([EMAIL])
  notifyEvents   NotificationEvent[]   @default([ORDER_NEW, PAYMENT_CLAIMED, REVIEW_NEW])
  notifyEmail    String? // boşdursa hesabın e-poçtu
  notifyPhone    String? // boşdursa profilin nömrəsi
  memberships    Membership[]
}

model SocialLink {
  id        String         @id @default(cuid())
  profileId String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform  SocialPlatform
  label     String?
  url       String
  position  Int            @default(0)
}

// "Gördüyüm işlər"
model PortfolioItem {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String?
  linkUrl     String?
  position    Int     @default(0)
}

// Yüklənmiş şəkillər bazada saxlanılır: xarici fayl xidməti lazım deyil
model Media {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([profileId])
}

model Service {
  id             String    @id @default(cuid())
  profileId      String
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  category       String? // SERVICE_CATEGORIES-dən açar
  customCategory String? // "Digər" seçiləndə satıcının yazdığı növ
  imageUrl       String? // könüllü şəkil (/api/media/...)
  priceType      PriceType @default(FIXED)
  amountQepik    Int? // NEGOTIABLE üçün boş ola bilər; qəpik/sent
  currency       String    @default("AZN")
  duration       String? // köhnə sərbəst mətn ("60 dəq")
  durationDays   Int?
  durationWeeks  Int?
  durationMonths Int?
  isActive       Boolean   @default(true)
  blocked        Boolean   @default(false) // admin moderasiyası: səhifədə və kataloqda görünmür
  position       Int       @default(0)
  createdAt      DateTime  @default(now())

  orders  Order[]
  reviews Review[]

  @@index([isActive, category])
}

model Order {
  id            String      @id @default(cuid())
  profileId     String
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  customerEmail String?
  note          String?
  quantity      Int         @default(1)
  status        OrderStatus @default(PENDING_APPROVAL)
  source        String? // trafik mənbəyi: instagram, tiktok, direct...
  visitorId     String?
  createdAt     DateTime    @default(now())

  invoice Invoice?

  @@index([profileId, status])
}

model Invoice {
  id            String        @id @default(cuid())
  publicId      String        @unique // /i/<publicId>, təxmin edilə bilməz
  number        String // AYG-2026-0042
  profileId     String
  profile       Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  orderId       String?       @unique
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  customerEmail String?
  status        InvoiceStatus @default(DRAFT)
  paymentMethod PaymentMethod @default(MANUAL)
  totalQepik    Int
  currency      String        @default("AZN")
  note          String?
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  items     InvoiceItem[]
  payments  Payment[]
  reminders Reminder[]
  review    Review?

  @@unique([profileId, number])
  @@index([profileId, status])
  @@index([profileId, issuedAt])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  title     String
  quantity  Int     @default(1)
  unitQepik Int
  position  Int     @default(0)
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider    String // "manual" | gateway adı
  externalId  String?
  amountQepik Int
  status      PaymentStatus @default(PENDING)
  receiptUrl  String? // manual ödənişdə müştərinin yüklədiyi qəbz
  createdAt   DateTime      @default(now())

  @@unique([provider, externalId])
}

model Reminder {
  id        String    @id @default(cuid())
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  channel   Channel
  message   String
  sendAt    DateTime
  sentAt    DateTime?

  @@index([sendAt, sentAt])
}

enum EventType {
  VIEW // səhifəyə baxış
  ORDER_OPEN // sifariş formasını açdı
  PHONE_CLICK // "Zəng et"
  LINK_CLICK // sosial hesab və ya link
}

// Səhifə analitikası: anonim ziyarətçi id-si (brauzerdə saxlanılır), şəxsi məlumat yoxdur
model ProfileEvent {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      EventType
  visitorId String
  source    String // instagram | tiktok | whatsapp | facebook | telegram | google | direct | other
  device    String // mobile | desktop
  target    String? // xidmət id-si, platforma və ya link
  createdAt DateTime  @default(now())

  @@index([profileId, createdAt])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN // adminləri idarə edir, istifadəçi kimi daxil ola bilir
}

// Admin əməliyyatlarının jurnalı: kim, nə vaxt, nəyi dəyişib
model AdminLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String // plan_change | block | unblock | delete_user | service_block | service_unblock | logout_sessions
  targetType String // user | service
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// İstifadəçi fəaliyyəti: giriş, xidmət, faktura və s. Hesab silinsə də qeyd qalır (əlaqə yoxdur, e-poçt saxlanılır)
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String? // iş sahəsinin sahibi (hesab)
  actorUserId String? // əməliyyatı edən şəxs: komanda üzvü ola bilər
  actorName   String?
  profileId   String? // hansı səhifə üzərində
  email       String?
  action      String // login | login_failed | signup | service_create | invoice_paid ...
  details     String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

enum BillingMethod {
  CARD // bank kartı (gateway; açar yoxdursa test rejimi)
  BANK_TRANSFER // Karvan hesabına köçürmə, admin təsdiqləyir
}

enum BillingStatus {
  PENDING // köçürmə gözlənilir / yoxlanılır
  PAID // ödəniş alındı, aktivləşdirmə növbədədir
  ACTIVATED // tarif aktivdir
  REJECTED // admin rədd etdi
  FAILED // kart ödənişi alınmadı
}

// Satıcının Karvan abunəliyi üçün ödənişləri (müştəri fakturalarından ayrıdır)
model SubscriptionPayment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan
  months        Int
  amountQepik   Int
  method        BillingMethod
  status        BillingStatus @default(PENDING)
  reference     String        @unique // KRV-XXXXXX: köçürmədə təyinat
  cardLast4     String?
  couponCode    String? // tətbiq edilmiş endirim kodu
  discountQepik Int           @default(0) // endirim məbləği (amountQepik artıq endirimli dəyərdir)
  provider      String? // epoint | sandbox
  externalId    String?
  note          String?
  createdAt     DateTime      @default(now())
  paidAt        DateTime?
  activatedAt   DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum TeamRole {
  OWNER //   səhifənin sahibi: hər şey, o cümlədən abunəlik, rekvizitlər və komanda
  MANAGER // gündəlik iş: xidmət, sifariş, faktura, analitika, rəy cavabı
  STAFF //   yalnız sifariş və faktura
}

enum MemberStatus {
  INVITED //   dəvət göndərilib, hələ qəbul edilməyib
  ACTIVE
  SUSPENDED // tarif Pro Max-dan düşüb: məlumat qalır, giriş bağlanır
}

// Komanda üzvlüyü: bir profil (iş sahəsi) üzərində bir neçə hesabın işləməsi (Pro Max)
model Membership {
  id           String       @id @default(cuid())
  profileId    String
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId       String? //     dəvət qəbul edilənə qədər boş
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         TeamRole     @default(STAFF)
  status       MemberStatus @default(INVITED)
  invitedEmail String //      dəvətin göndərildiyi ünvan
  inviteToken  String?      @unique // tokenin sha256 heşi
  inviteExpiry DateTime?
  invitedBy    String? //     dəvət edən istifadəçinin e-poçtu
  invitedAt    DateTime     @default(now())
  acceptedAt   DateTime?

  @@unique([profileId, userId])
  @@unique([profileId, invitedEmail])
  @@index([userId, status])
}

// Müştəri rəyi: yalnız ödənilmiş fakturaya görə yazıla bilər (bir faktura — bir rəy)
model Review {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  invoiceId    String    @unique
  invoice      Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId    String? //  rəyin aid olduğu xidmət (sifarişdən gələndə)
  service      Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  rating       Int //      1-5
  comment      String?
  customerName String //   fakturadakı ad; səhifədə qısaldılmış göstərilir
  reply        String? //  satıcının cavabı
  repliedAt    DateTime?
  hidden       Boolean   @default(false) // admin moderasiyası
  hiddenReason String?
  createdAt    DateTime  @default(now())

  @@index([profileId, hidden, createdAt])
  @@index([serviceId])
}

enum NotifyMode {
  AUTO //   hadisə baş verən kimi göndərilir
  MANUAL // növbəyə düşür, satıcı paneldən göndərir
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationEvent {
  ORDER_NEW //        yeni sifariş
  PAYMENT_CLAIMED //  müştəri "Ödədim" bildirdi
  PAYMENT_CONFIRMED // ödəniş təsdiqləndi
  REVIEW_NEW //       yeni rəy
}

enum NotificationStatus {
  QUEUED //  göndərilməyi gözləyir (manual rejim və ya növbə)
  SENT
  FAILED
  SKIPPED // kanal qoşulmayıb
}

// Bildiriş növbəsi və jurnalı: avtomatik və manual göndərmə eyni cədvəldən keçir
model Notification {
  id        String              @id @default(cuid())
  profileId String
  profile   Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  event     NotificationEvent
  channel   NotificationChannel
  status    NotificationStatus  @default(QUEUED)
  mode      NotifyMode
  target    String? //            e-poçt ünvanı və ya nömrə
  title     String
  body      String
  linkPath  String? //            panelin müvafiq səhifəsi
  entityId  String? //            sifariş / faktura / rəy id-si
  error     String?
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  @@index([profileId, status, createdAt])
}

enum DiscountType {
  PERCENT // faizlə endirim
  FIXED //   sabit məbləğ (qəpik)
}

// Kampaniya / endirim kodu: admin yaradır, ödəniş səhifəsində tətbiq olunur
model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique // böyük hərflərlə saxlanılır
  type           DiscountType @default(PERCENT)
  value          Int //                faiz (1-100) və ya qəpik məbləği
  plans          Plan[] //              boşdursa bütün ödənişli tariflər
  months         Int? //                yalnız bu müddət üçün (1 və ya 12); boşdursa hamısı
  maxUses        Int? //                ümumi istifadə limiti; boşdursa limitsiz
  maxUsesPerUser Int?         @default(1) // bir istifadəçinin istifadə sayı
  usedCount      Int          @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean      @default(true)
  note           String?
  createdBy      String? //             admin e-poçtu
  createdAt      DateTime     @default(now())

  redemptions CouponRedemption[]

  @@index([isActive, endsAt])
}

// Kuponun hansı ödənişdə istifadə olunduğu: təkrar istifadəyə nəzarət və hesabat
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId        String
  paymentId     String?  @unique
  discountQepik Int
  createdAt     DateTime @default(now())

  @@index([couponId, createdAt])
  @@index([userId])
}

// Admin paneldən idarə olunan ayarlar (məs. AI açarı: şifrələnmiş saxlanılır)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
